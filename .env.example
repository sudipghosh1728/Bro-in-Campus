# Live MongoDB server (required). Use your MongoDB Atlas connection string.
# Keep this secret in .env only; never commit a real username or password.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/bro_in_campus?retryWrites=true&w=majority"

# A high-entropy, private value used to sign session tokens. Generate a new value for every environment.
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps Embed API. Enable “Maps Embed API” for this key in Google Cloud
# Console, then restrict it to this app's HTTP referrers. This browser key is
# intentionally public, so never use an unrestricted server-side key here.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY="your-browser-restricted-google-maps-key"

# Gmail SMTP for password-reset OTP delivery. Generate an App Password from a
# Google account with 2-Step Verification enabled; never use the Gmail login
# password here. GMAIL_FROM is optional and normally matches GMAIL_USER.
GMAIL_USER="your-campus-mail@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"
GMAIL_FROM="Bro in Campus <your-campus-mail@gmail.com>"

# Optional market-provider configuration. Nearby markets are discovered with
# Overpass from a place's browser-approved location. Use an identifiable
# application/contact user-agent when deploying rather than the local default.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
LOCATION_USER_AGENT="BroInCampus/1.0 (your-contact@example.com)"

# Optional abstractions for production storage and cross-instance realtime.
REALTIME_URL=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
